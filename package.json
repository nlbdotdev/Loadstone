{
  "name": "loadstone",
  "version": "0.4.0",
  "private": true,
  "description": "Your next playthrough, ready. A curated modlist desktop experience.",
  "author": "nlbdotdev",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/write-build-info.mjs",
    "start": "pnpm build && electron .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/state.test.mjs",
    "package": "pnpm notices && electron-builder --win portable --x64",
    "notices": "pnpm build && pnpm licenses list --prod --json | node scripts/generate-notices.mjs",
    "package:steam": "pnpm notices && electron-builder --win --x64 --dir -c.directories.output=release/steam-unpacked && node scripts/steam-depot.mjs release/steam-unpacked/win-unpacked",
    "audit:publication": "node scripts/audit-publication.mjs",
    "assets:steam": "node scripts/steam-artwork.mjs",
    "assets:icon": "node scripts/create-icon.mjs",
    "handbook:sync": "node scripts/handbook.mjs sync",
    "handbook:dev": "node scripts/handbook.mjs && vite --config handbook/vite.config.ts",
    "handbook:check": "node scripts/handbook.mjs check && node scripts/handbook.mjs && svelte-check --tsconfig handbook/tsconfig.json",
    "handbook:build": "node scripts/handbook.mjs && vite build --config handbook/vite.config.ts",
    "handbook:preview": "vite preview --config handbook/vite.config.ts",
    "handbook:test": "pnpm handbook:build && node --test handbook/tests/*.test.mjs"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@lucide/svelte": "^1.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "marked": "18.1.1",
    "playwright": "^1.58.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "dev.nlb.loadstone",
    "productName": "Loadstone",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Loadstone-${version}-Windows.exe"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/Loadstone-GPL-3.0.txt"
      },
      {
        "from": "COPYRIGHT",
        "to": "licenses/Loadstone-COPYRIGHT.txt"
      },
      {
        "from": "notices",
        "to": "notices",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
