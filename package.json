{
  "name": "loadstone",
  "version": "0.1.0",
  "private": true,
  "description": "Your next playthrough, ready. A curated modlist desktop experience.",
  "author": "nlbdotdev",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "pnpm build && electron .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm build && node --test tests/electron.test.mjs",
    "package": "pnpm build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.58.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.nlb.loadstone",
    "productName": "Loadstone",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "portable", "icon": "build/icon.ico", "signAndEditExecutable": false },
    "portable": { "artifactName": "Loadstone-${version}-Windows.exe" }
  },
  "pnpm": { "onlyBuiltDependencies": ["electron", "esbuild"] }
}
